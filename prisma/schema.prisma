// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model PlantGroup {
  id     Int     @id @default(autoincrement())
  name   String
  plants Plant[]

  @@map("plant_group")
}

model Plant {
  id           Int        @id @default(autoincrement())
  name         String
  description  String
  plantGroupId Int        @map("plant_group_id")
  plantGroup   PlantGroup @relation(fields: [plantGroupId], references: [id])
  norms        Norms?     @relation("PlantNorms")
  zones        Zone[]

  schedulePresets SchedulePreset[]

  @@map("plant")
}

model Norms {
  id Int @id @default(autoincrement())

  temperatureMin           Float @map("temperature_min")
  temperatureMax           Float @map("temperature_max")
  airHumidityMin           Float @map("air_humidity_min")
  airHumidityMax           Float @map("air_humidity_max")
  substrateHumidityMin     Float @map("substrate_humidity_min")
  substrateHumidityMax     Float @map("substrate_humidity_max")
  phLevelMin               Float @map("ph_level_min")
  phLevelMax               Float @map("ph_level_max")
  nutrientConcentrationMin Float @map("nutrient_concentration_min")
  nutrientConcentrationMax Float @map("nutrient_concentration_max")
  solutionTemperatureMin   Float @map("solution_temperature_min")
  solutionTemperatureMax   Float @map("solution_temperature_max")
  solutionLvlMin           Float @map("solution_lvl_min")
  solutionLvlMax           Float @map("solution_lvl_max")
  lightIntensityMin        Float @map("light_intensity_min")
  lightIntensityMax        Float @map("light_intensity_max")

  plantId Int   @unique @map("plant_id")
  plant   Plant @relation("PlantNorms", fields: [plantId], references: [id])

  @@map("norms")
}

model Station {
  id                 Int                 @id @default(autoincrement())
  uuid               String              @unique
  name               String
  zones              Zone[]
  bucketLogs         BucketParamsLog[]
  bucketParams       BucketParams?
  bucketTargetParams BucketTargetParams?

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  @@map("station")
}

model BucketParams {
  id        Int     @id @default(autoincrement())
  stationId Int     @unique @map("station_id")
  station   Station @relation(fields: [stationId], references: [id])

  phLevel               Float    @map("ph_level")
  nutrientConcentration Float    @map("nutrient_concentration")
  solutionTemperature   Float    @map("solution_temperature")
  solutionLvl           Float    @map("solution_lvl")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("bucket_params")
}

model BucketParamsLog {
  id        Int     @id @default(autoincrement())
  stationId Int     @map("station_id")
  station   Station @relation(fields: [stationId], references: [id])

  recordedAt DateTime @default(now()) @map("recorded_at")

  phLevel               Float @map("ph_level")
  nutrientConcentration Float @map("nutrient_concentration")
  solutionTemperature   Float @map("solution_temperature")
  solutionLvl           Float @map("solution_lvl")

  @@index([stationId, recordedAt])
  @@map("bucket_params_log")
}

model Zone {
  id      Int    @id @default(autoincrement())
  index   Int
  name    String
  plantId Int?   @map("plant_id")
  plant   Plant? @relation(fields: [plantId], references: [id])

  stationId Int     @map("station_id")
  station   Station @relation(fields: [stationId], references: [id])

  zoneLogs             ZoneParamsLog[]
  zoneParams           ZoneParams?
  zoneNorms            ZoneNorms?
  zoneTargetParams     ZoneTargetParams?
  zoneScheduleInterval ZoneScheduleInterval[]

  @@map("zone")
}

model ZoneScheduleInterval {
  id     Int  @id @default(autoincrement())
  zoneId Int  @map("zone_id")
  zone   Zone @relation(fields: [zoneId], references: [id])

  device DeviceType
  onTime String     @map("on_time")

  // LIGHT/FAN run for a duration (onTime -> offTime); PUMP instead fires
  // once at onTime for a set volume, so offTime is unused and volumeMl is
  // unused for LIGHT/FAN.
  offTime  String? @map("off_time")
  volumeMl Int?    @map("volume_ml")

  @@map("zone_schedule_interval")
}

// A reusable, named set of device intervals a user can save and apply to
// any zone later — the same interval shape as ZoneScheduleInterval.
// Optionally tied to a Plant to act as that plant's recommended schedule.
model SchedulePreset {
  id     Int    @id @default(autoincrement())
  name   String
  userId Int    @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  plantId Int?   @map("plant_id")
  plant   Plant? @relation(fields: [plantId], references: [id])

  intervals SchedulePresetInterval[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("schedule_preset")
}

model SchedulePresetInterval {
  id       Int            @id @default(autoincrement())
  presetId Int            @map("preset_id")
  preset   SchedulePreset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  device DeviceType
  onTime String     @map("on_time")

  offTime  String? @map("off_time")
  volumeMl Int?    @map("volume_ml")

  @@map("schedule_preset_interval")
}

enum DeviceType {
  LIGHT
  PUMP
  FAN

  @@map("device_type")
}

model ZoneNorms {
  id Int @id @default(autoincrement())

  temperatureMin           Float? @map("temperature_min")
  temperatureMax           Float? @map("temperature_max")
  airHumidityMin           Float? @map("air_humidity_min")
  airHumidityMax           Float? @map("air_humidity_max")
  substrateHumidityMin     Float? @map("substrate_humidity_min")
  substrateHumidityMax     Float? @map("substrate_humidity_max")
  phLevelMin               Float? @map("ph_level_min")
  phLevelMax               Float? @map("ph_level_max")
  nutrientConcentrationMin Float? @map("nutrient_concentration_min")
  nutrientConcentrationMax Float? @map("nutrient_concentration_max")
  solutionTemperatureMin   Float? @map("solution_temperature_min")
  solutionTemperatureMax   Float? @map("solution_temperature_max")
  solutionLvlMin           Float? @map("solution_lvl_min")
  solutionLvlMax           Float? @map("solution_lvl_max")
  lightIntensityMin        Float? @map("light_intensity_min")
  lightIntensityMax        Float? @map("light_intensity_max")

  zoneId Int  @unique @map("zone_id")
  zone   Zone @relation(fields: [zoneId], references: [id])

  @@map("zone_norms")
}

model ZoneParams {
  id     Int  @id @default(autoincrement())
  zoneId Int  @unique @map("zone_id")
  zone   Zone @relation(fields: [zoneId], references: [id])

  temperature       Float
  airHumidity       Float    @map("air_humidity")
  substrateHumidity Float    @map("substrate_humidity")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("zone_params")
}

model ZoneParamsLog {
  id     Int  @id @default(autoincrement())
  zoneId Int  @map("zone_id")
  zone   Zone @relation(fields: [zoneId], references: [id])

  recordedAt DateTime @default(now()) @map("recorded_at")

  temperature       Float
  airHumidity       Float @map("air_humidity")
  substrateHumidity Float @map("substrate_humidity")

  @@index([zoneId, recordedAt])
  @@map("zone_params_log")
}

model BucketTargetParams {
  id        Int     @id @default(autoincrement())
  stationId Int     @unique @map("station_id")
  station   Station @relation(fields: [stationId], references: [id])

  phLevel               Float    @map("ph_level")
  nutrientConcentration Float    @map("nutrient_concentration")
  solutionTemperature   Float    @map("solution_temperature")
  solutionLvl           Float    @map("solution_lvl")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("bucket_target_params")
}

model ZoneTargetParams {
  id     Int  @id @default(autoincrement())
  zoneId Int  @unique @map("zone_id")
  zone   Zone @relation(fields: [zoneId], references: [id])

  temperature       Float
  airHumidity       Float    @map("air_humidity")
  substrateHumidity Float    @map("substrate_humidity")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("zone_target_params")
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  name     String
  password String
  role     Role   @default(USER)

  stations        Station[]
  schedulePresets SchedulePreset[]

  @@map("user")
}

enum Role {
  ADMIN
  USER

  @@map("role")
}
